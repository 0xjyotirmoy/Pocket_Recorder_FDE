# Optional. The recommended way to store the key is ONCE, outside the project:
#     python manage.py set-key gsk_your_key      (saved in ~/.fieldnotes/config.env)
# Values here (project .env) override that file. Never commit .env.

# GROQ_API_KEY=

# --- Speech to text: groq | local (faster-whisper, offline) | fake ---
# ASR_PROVIDER=groq
# GROQ_ASR_MODEL=whisper-large-v3
# ASR_LANGUAGE=          # en | hi | bn ; empty = auto-detect
# ASR_FALLBACK=          # "local" -> use faster-whisper if Groq fails (pip install -r backend/requirements-local.txt)

# --- LLM: any OpenAI-compatible endpoint (default Groq, reuses GROQ_API_KEY) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=

# --- App ---
# APP_TIMEZONE=Asia/Kolkata
# DATA_DIR=              # default ~/.fieldnotes/data (database + audio)
# MAX_UPLOAD_MB=200
